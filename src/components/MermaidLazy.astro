---
// Mermaid 懒加载组件 - 只在图表进入视口时才加载和渲染
---

<div class="mermaid-lazy" data-mermaid>
	<slot />
</div>

<script>
	class MermaidLazyLoader {
		private observer: IntersectionObserver | null = null;
		private loaded = false;

		constructor() {
			this.init();
		}

		private async init() {
			// 等待 DOM 加载完成
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', () => this.observe());
			} else {
				this.observe();
			}
		}

		private observe() {
			const blocks = document.querySelectorAll('.mermaid-lazy[data-mermaid]');
			if (blocks.length === 0) return;

			// 使用 Intersection Observer 监听
			this.observer = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							this.renderBlock(entry.target as HTMLElement);
							observer.unobserve(entry.target);
						}
					});
				},
				{
					rootMargin: '200px', // 提前 200px 开始加载
					threshold: 0,
				}
			);

			blocks.forEach((block) => this.observer!.observe(block));
		}

		private async renderBlock(block: HTMLElement) {
			// 显示加载提示
			block.innerHTML = '<div style="text-align:center;padding:1em;color:#888;">📊 图表加载中...</div>';

			try {
				// 动态导入 mermaid（只在需要时加载）
				if (!this.loaded) {
					await this.loadMermaid();
					this.loaded = true;
				}

				// 获取原始代码
				const code = block.getAttribute('data-code') || '';
				if (!code) return;

				// 渲染图表
				const { svg } = await window.mermaid.render(
					`mermaid-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
					code
				);

				block.innerHTML = svg;
			} catch (error) {
				console.error('Mermaid 渲染失败:', error);
				block.innerHTML = `<div style="text-align:center;padding:1em;color:#e53e3e;">⚠️ 图表加载失败</div>`;
			}
		}

		private async loadMermaid(): Promise<void> {
			// 动态加载 mermaid 库
			return new Promise((resolve, reject) => {
				const script = document.createElement('script');
				script.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
				script.type = 'module';

				// 使用 importmap 方式加载
				const importMap = document.createElement('script');
				importMap.type = 'importmap';
				importMap.textContent = JSON.stringify({
					imports: {
						mermaid: 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs',
					},
				});

				if (!document.querySelector('script[type="importmap"]')) {
					document.head.appendChild(importMap);
				}

				// 直接使用 ESM 导入
				import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
					.then((mermaid) => {
						(window as any).mermaid = mermaid.default || mermaid;
						mermaid.default?.initialize({
							startOnLoad: false,
							theme: 'default',
							securityLevel: 'loose',
						}) || mermaid.initialize({
							startOnLoad: false,
							theme: 'default',
							securityLevel: 'loose',
						});
						resolve();
					})
					.catch(reject);
			});
		}
	}

	// 初始化
	new MermaidLazyLoader();
</script>

<style>
	.mermaid-lazy {
		margin: 1em 0;
		text-align: center;
	}

	.mermaid-lazy :global(svg) {
		max-width: 100%;
		height: auto;
	}
</style>
